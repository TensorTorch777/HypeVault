{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypevault.example/schemas/phase68-acquisition-decision-record.schema.json",
  "title": "HypeVault Phase 68 Acquisition Decision Record",
  "description": "Human-reviewed recommendation package for considering future acquisition authorization. Schema-valid records do not authorize acquisition, inference, authenticity claims, or production promotion. overall_outcome never toggles ACQUISITION_AUTHORIZED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_record_id",
    "created_at_utc",
    "research_purpose",
    "proposed_sources",
    "rights_and_license_review",
    "privacy_consent_ethics_review",
    "ground_truth_requirements",
    "dataset_design_and_leakage_plan",
    "security_storage_retention_plan",
    "budget_and_ownership",
    "reviewers",
    "unresolved_blockers",
    "overall_outcome",
    "overall_rationale",
    "acquisition_authorized_by_this_record",
    "gates_unchanged_acknowledgment"
  ],
  "properties": {
    "schema_version": {
      "const": "phase68_acquisition_decision_record_v1"
    },
    "decision_record_id": {
      "type": "string",
      "pattern": "^acqdec_[A-Za-z0-9_-]{8,64}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp string. May be NOT_RECORDED only in incomplete drafts if overall_outcome is DRAFT."
    },
    "updated_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "research_purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_questions",
        "permitted_model_development_purpose",
        "product_category_scope",
        "intended_audience",
        "publication_boundaries",
        "explicit_out_of_scope_uses"
      ],
      "properties": {
        "research_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "permitted_model_development_purpose": {
          "enum": [
            "ML_EVALUATION_ONLY",
            "NONPUBLIC_RESEARCH",
            "PUBLICATION_OF_AGGREGATES",
            "OTHER_DOCUMENTED",
            "NOT_RECORDED"
          ]
        },
        "product_category_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "intended_audience": {"type": "string", "minLength": 1},
        "publication_boundaries": {"type": "string", "minLength": 1},
        "explicit_out_of_scope_uses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "proposed_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "canonical_name",
          "public_urls",
          "intended_acquisition_method",
          "scope_limit",
          "terms_evidence_refs",
          "copyright_redistribution_notes",
          "provider_permission_status",
          "storage_transformation_publication_restrictions",
          "reviewer_ref",
          "reviewed_at_utc",
          "evidence_refs",
          "expiration_or_review_by"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^source_[A-Za-z0-9_-]{4,64}$"
          },
          "canonical_name": {"type": "string", "minLength": 1},
          "public_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "intended_acquisition_method": {"type": "string", "minLength": 1},
          "scope_limit": {"type": "string", "minLength": 1},
          "terms_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "copyright_redistribution_notes": {"type": "string", "minLength": 1},
          "provider_permission_status": {
            "enum": [
              "REQUIRED_MISSING",
              "REQUIRED_PENDING",
              "REQUIRED_OBTAINED",
              "NOT_REQUIRED",
              "DENIED",
              "NOT_RECORDED"
            ]
          },
          "provider_permission_rationale": {"type": "string"},
          "storage_transformation_publication_restrictions": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_ref": {"type": "string", "minLength": 1},
          "reviewed_at_utc": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "expiration_or_review_by": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider_permission_status": {"const": "NOT_REQUIRED"}
              },
              "required": ["provider_permission_status"]
            },
            "then": {
              "required": ["provider_permission_rationale"],
              "properties": {
                "provider_permission_rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "rights_and_license_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "privacy_consent_ethics_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "faculty_or_institutional_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "ground_truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_verification_procedure_ref",
        "reviewer_qualification_requirements",
        "dual_review_and_adjudication_defined",
        "excludes_filename_directory_scraper_seller_model_synthetic_as_gt",
        "distinction_review_eligibility_vs_ml_admission_documented",
        "evidence_refs"
      ],
      "properties": {
        "independent_verification_procedure_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_qualification_requirements": {
          "type": "string",
          "minLength": 1
        },
        "dual_review_and_adjudication_defined": {"type": "boolean"},
        "excludes_filename_directory_scraper_seller_model_synthetic_as_gt": {
          "const": true,
          "description": "Must be true. Weak labels cannot be treated as independent ground truth."
        },
        "distinction_review_eligibility_vs_ml_admission_documented": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "dataset_design_and_leakage_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_scheme",
        "duplicate_detection_policy",
        "disjointness_rules",
        "split_separation_policy_level_only",
        "final_test_ood_inspection_prohibited",
        "missing_metadata_reporting",
        "evidence_refs"
      ],
      "properties": {
        "identity_scheme": {"type": "string", "minLength": 1},
        "duplicate_detection_policy": {"type": "string", "minLength": 1},
        "disjointness_rules": {"type": "string", "minLength": 1},
        "split_separation_policy_level_only": {"type": "string", "minLength": 1},
        "final_test_ood_inspection_prohibited": {
          "const": true
        },
        "missing_metadata_reporting": {"type": "string", "minLength": 1},
        "proposed_thresholds_require_human_approval": {
          "const": true,
          "description": "Numeric thresholds in plans are proposals until separately approved."
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "security_storage_retention_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_designation",
        "access_control_summary",
        "checksum_and_audit_requirements",
        "retention_and_backup_policy",
        "deletion_takedown_quarantine_procedures",
        "incident_owner_ref",
        "evidence_refs"
      ],
      "properties": {
        "storage_designation": {"type": "string", "minLength": 1},
        "access_control_summary": {"type": "string", "minLength": 1},
        "checksum_and_audit_requirements": {"type": "string", "minLength": 1},
        "retention_and_backup_policy": {"type": "string", "minLength": 1},
        "deletion_takedown_quarantine_procedures": {
          "type": "string",
          "minLength": 1
        },
        "incident_owner_ref": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "budget_and_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_mode",
        "accountable_owner_ref",
        "time_window",
        "volume_or_rate_limits",
        "stop_condition_before_expenditure",
        "evidence_refs"
      ],
      "properties": {
        "budget_mode": {
          "enum": [
            "ZERO_BUDGET_DESK_ONLY",
            "CEILING_DOCUMENTED",
            "NOT_RECORDED"
          ]
        },
        "budget_ceiling": {"type": "string"},
        "funding_source": {"type": "string"},
        "accountable_owner_ref": {"type": "string", "minLength": 1},
        "time_window": {"type": "string", "minLength": 1},
        "volume_or_rate_limits": {"type": "string", "minLength": 1},
        "stop_condition_before_expenditure": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"budget_mode": {"const": "CEILING_DOCUMENTED"}},
            "required": ["budget_mode"]
          },
          "then": {
            "required": ["budget_ceiling", "funding_source"],
            "properties": {
              "budget_ceiling": {"type": "string", "minLength": 1},
              "funding_source": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_ref",
          "role",
          "decision",
          "decided_at_utc",
          "evidence_refs"
        ],
        "properties": {
          "reviewer_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Pseudonymous role reference; not a real-world name in Git."
          },
          "role": {
            "enum": [
              "PREPARER",
              "RIGHTS_LICENSE",
              "PRIVACY_ETHICS",
              "GROUND_TRUTH",
              "DATASET_INTEGRITY",
              "SECURITY_RETENTION",
              "BUDGET_OWNER",
              "LEAD_REVIEWER",
              "OTHER"
            ]
          },
          "decision": {
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "APPROVE_FOR_RECOMMENDATION_REVIEW",
              "REJECT",
              "ABSTAIN",
              "NOT_APPLICABLE"
            ]
          },
          "not_applicable_rationale": {"type": "string"},
          "decided_at_utc": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"decision": {"const": "NOT_APPLICABLE"}},
              "required": ["decision"]
            },
            "then": {
              "required": ["not_applicable_rationale"],
              "properties": {
                "not_applicable_rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "severity",
          "description",
          "remediation_owner_ref",
          "status"
        ],
        "properties": {
          "blocker_id": {
            "type": "string",
            "pattern": "^blocker_[A-Za-z0-9_-]{4,64}$"
          },
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "description": {"type": "string", "minLength": 1},
          "remediation_owner_ref": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "WITHDRAWN"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence_ref"}
          }
        }
      }
    },
    "exceptions_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exception_id", "description", "status"],
        "properties": {
          "exception_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["REQUESTED", "DENIED", "WITHDRAWN", "NOT_GRANTED"]
          }
        }
      }
    },
    "expiration_or_next_review_utc": {"type": "string", "minLength": 1},
    "overall_outcome": {
      "enum": [
        "DRAFT",
        "NO_GO",
        "CONDITIONAL_NO_GO",
        "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED"
      ],
      "description": "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED is a recommendation only. It must never be interpreted as ACQUISITION_AUTHORIZED=true."
    },
    "overall_rationale": {"type": "string", "minLength": 1},
    "acquisition_authorized_by_this_record": {
      "const": false,
      "description": "Immutable false. This record cannot authorize acquisition."
    },
    "gates_unchanged_acknowledgment": {
      "const": true,
      "description": "Preparer acknowledges that completing this record does not change ACQUISITION_AUTHORIZED, INFERENCE_AUTHORIZED, DATA_READINESS, publication, or promotion gates."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_outcome": {
            "const": "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED"
          }
        },
        "required": ["overall_outcome"]
      },
      "then": {
        "properties": {
          "acquisition_authorized_by_this_record": {"const": false},
          "unresolved_blockers": {
            "type": "array",
            "items": {
              "not": {
                "properties": {
                  "severity": {"const": "CRITICAL"},
                  "status": {"enum": ["OPEN", "IN_PROGRESS"]}
                },
                "required": ["severity", "status"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"overall_outcome": {"const": "NO_GO"}},
        "required": ["overall_outcome"]
      },
      "then": {
        "properties": {
          "unresolved_blockers": {"type": "array", "minItems": 1}
        },
        "required": ["unresolved_blockers"]
      }
    }
  ],
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "title", "uri_or_path", "retrieved_at_utc"],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^eref_[A-Za-z0-9_-]{4,64}$"
        },
        "title": {"type": "string", "minLength": 1},
        "uri_or_path": {"type": "string", "minLength": 1},
        "retrieved_at_utc": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^([a-f0-9]{64}|NOT_RECORDED)$"
        },
        "notes": {"type": "string"}
      }
    },
    "applicability_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "status", "reviewer_ref", "evidence_refs"],
      "properties": {
        "applicability": {
          "enum": ["APPLICABLE", "NOT_APPLICABLE", "NOT_RECORDED"]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "COMPLETE_PASS",
            "COMPLETE_FAIL",
            "EXPIRED",
            "WITHDRAWN",
            "NOT_RECORDED"
          ]
        },
        "not_applicable_rationale": {"type": "string"},
        "reviewer_ref": {"type": "string", "minLength": 1},
        "reviewed_at_utc": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"applicability": {"const": "NOT_APPLICABLE"}},
            "required": ["applicability"]
          },
          "then": {
            "required": ["not_applicable_rationale"],
            "properties": {
              "not_applicable_rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
