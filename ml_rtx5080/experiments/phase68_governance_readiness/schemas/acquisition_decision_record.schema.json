{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypevault.example/schemas/phase68-acquisition-decision-record.schema.json",
  "title": "HypeVault Phase 68 Acquisition Decision Record",
  "description": "Human-reviewed recommendation package for considering future acquisition authorization. Schema-valid records do not authorize acquisition, inference, authenticity claims, or production promotion. overall_outcome never toggles ACQUISITION_AUTHORIZED. GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED requires structurally complete applicable reviews and evidence; JSON Schema cannot prove legal rights, ethical clearance, or factual authenticity of approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_record_id",
    "created_at_utc",
    "research_purpose",
    "proposed_sources",
    "rights_and_license_review",
    "privacy_consent_ethics_review",
    "ground_truth_requirements",
    "dataset_design_and_leakage_plan",
    "security_storage_retention_plan",
    "budget_and_ownership",
    "reviewers",
    "unresolved_blockers",
    "overall_outcome",
    "overall_rationale",
    "acquisition_authorized_by_this_record",
    "gates_unchanged_acknowledgment"
  ],
  "properties": {
    "schema_version": {
      "const": "phase68_acquisition_decision_record_v1"
    },
    "decision_record_id": {
      "type": "string",
      "pattern": "^acqdec_[A-Za-z0-9_-]{8,64}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp string. May be NOT_RECORDED only in incomplete drafts if overall_outcome is DRAFT."
    },
    "updated_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "research_purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_questions",
        "permitted_model_development_purpose",
        "product_category_scope",
        "intended_audience",
        "publication_boundaries",
        "explicit_out_of_scope_uses"
      ],
      "properties": {
        "research_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "permitted_model_development_purpose": {
          "enum": [
            "ML_EVALUATION_ONLY",
            "NONPUBLIC_RESEARCH",
            "PUBLICATION_OF_AGGREGATES",
            "OTHER_DOCUMENTED",
            "NOT_RECORDED"
          ]
        },
        "product_category_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "intended_audience": {"type": "string", "minLength": 1},
        "publication_boundaries": {"type": "string", "minLength": 1},
        "explicit_out_of_scope_uses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "proposed_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "canonical_name",
          "public_urls",
          "intended_acquisition_method",
          "scope_limit",
          "terms_evidence_refs",
          "copyright_redistribution_notes",
          "provider_permission_status",
          "storage_transformation_publication_restrictions",
          "reviewer_ref",
          "reviewed_at_utc",
          "evidence_refs",
          "expiration_or_review_by"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^source_[A-Za-z0-9_-]{4,64}$"
          },
          "canonical_name": {"type": "string", "minLength": 1},
          "public_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "intended_acquisition_method": {"type": "string", "minLength": 1},
          "scope_limit": {"type": "string", "minLength": 1},
          "terms_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "copyright_redistribution_notes": {"type": "string", "minLength": 1},
          "provider_permission_status": {
            "enum": [
              "REQUIRED_MISSING",
              "REQUIRED_PENDING",
              "REQUIRED_OBTAINED",
              "NOT_REQUIRED",
              "DENIED",
              "NOT_RECORDED"
            ]
          },
          "provider_permission_rationale": {"type": "string"},
          "storage_transformation_publication_restrictions": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_ref": {"type": "string", "minLength": 1},
          "reviewed_at_utc": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "expiration_or_review_by": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider_permission_status": {"const": "NOT_REQUIRED"}
              },
              "required": ["provider_permission_status"]
            },
            "then": {
              "required": ["provider_permission_rationale"],
              "properties": {
                "provider_permission_rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "rights_and_license_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "privacy_consent_ethics_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "faculty_or_institutional_review": {
      "$ref": "#/$defs/applicability_block"
    },
    "ground_truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_verification_procedure_ref",
        "reviewer_qualification_requirements",
        "dual_review_and_adjudication_defined",
        "excludes_filename_directory_scraper_seller_model_synthetic_as_gt",
        "distinction_review_eligibility_vs_ml_admission_documented",
        "evidence_refs"
      ],
      "properties": {
        "independent_verification_procedure_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_qualification_requirements": {
          "type": "string",
          "minLength": 1
        },
        "dual_review_and_adjudication_defined": {"type": "boolean"},
        "excludes_filename_directory_scraper_seller_model_synthetic_as_gt": {
          "const": true,
          "description": "Must be true. Weak labels cannot be treated as independent ground truth."
        },
        "distinction_review_eligibility_vs_ml_admission_documented": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "dataset_design_and_leakage_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_scheme",
        "duplicate_detection_policy",
        "disjointness_rules",
        "split_separation_policy_level_only",
        "final_test_ood_inspection_prohibited",
        "missing_metadata_reporting",
        "evidence_refs"
      ],
      "properties": {
        "identity_scheme": {"type": "string", "minLength": 1},
        "duplicate_detection_policy": {"type": "string", "minLength": 1},
        "disjointness_rules": {"type": "string", "minLength": 1},
        "split_separation_policy_level_only": {"type": "string", "minLength": 1},
        "final_test_ood_inspection_prohibited": {
          "const": true
        },
        "missing_metadata_reporting": {"type": "string", "minLength": 1},
        "proposed_thresholds_require_human_approval": {
          "const": true,
          "description": "Numeric thresholds in plans are proposals until separately approved."
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "security_storage_retention_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_designation",
        "access_control_summary",
        "checksum_and_audit_requirements",
        "retention_and_backup_policy",
        "deletion_takedown_quarantine_procedures",
        "incident_owner_ref",
        "evidence_refs"
      ],
      "properties": {
        "storage_designation": {"type": "string", "minLength": 1},
        "access_control_summary": {"type": "string", "minLength": 1},
        "checksum_and_audit_requirements": {"type": "string", "minLength": 1},
        "retention_and_backup_policy": {"type": "string", "minLength": 1},
        "deletion_takedown_quarantine_procedures": {
          "type": "string",
          "minLength": 1
        },
        "incident_owner_ref": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "budget_and_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_mode",
        "accountable_owner_ref",
        "time_window",
        "volume_or_rate_limits",
        "stop_condition_before_expenditure",
        "evidence_refs"
      ],
      "properties": {
        "budget_mode": {
          "enum": [
            "ZERO_BUDGET_DESK_ONLY",
            "CEILING_DOCUMENTED",
            "NOT_RECORDED"
          ]
        },
        "budget_ceiling": {"type": "string"},
        "funding_source": {"type": "string"},
        "accountable_owner_ref": {"type": "string", "minLength": 1},
        "time_window": {"type": "string", "minLength": 1},
        "volume_or_rate_limits": {"type": "string", "minLength": 1},
        "stop_condition_before_expenditure": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"budget_mode": {"const": "CEILING_DOCUMENTED"}},
            "required": ["budget_mode"]
          },
          "then": {
            "required": ["budget_ceiling", "funding_source"],
            "properties": {
              "budget_ceiling": {"type": "string", "minLength": 1},
              "funding_source": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_ref",
          "role",
          "decision",
          "decided_at_utc",
          "evidence_refs"
        ],
        "properties": {
          "reviewer_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Pseudonymous role reference; not a real-world name in Git."
          },
          "role": {
            "enum": [
              "PREPARER",
              "RIGHTS_LICENSE",
              "PRIVACY_ETHICS",
              "GROUND_TRUTH",
              "DATASET_INTEGRITY",
              "SECURITY_RETENTION",
              "BUDGET_OWNER",
              "LEAD_REVIEWER",
              "OTHER"
            ]
          },
          "decision": {
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "APPROVE_FOR_RECOMMENDATION_REVIEW",
              "REJECT",
              "ABSTAIN",
              "NOT_APPLICABLE"
            ]
          },
          "not_applicable_rationale": {"type": "string"},
          "decided_at_utc": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_ref"}
          },
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"decision": {"const": "NOT_APPLICABLE"}},
              "required": ["decision"]
            },
            "then": {
              "required": ["not_applicable_rationale"],
              "properties": {
                "not_applicable_rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "severity",
          "description",
          "remediation_owner_ref",
          "status"
        ],
        "properties": {
          "blocker_id": {
            "type": "string",
            "pattern": "^blocker_[A-Za-z0-9_-]{4,64}$"
          },
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "description": {"type": "string", "minLength": 1},
          "remediation_owner_ref": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "WITHDRAWN"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence_ref"}
          }
        }
      }
    },
    "exceptions_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exception_id", "description", "status"],
        "properties": {
          "exception_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["REQUESTED", "DENIED", "WITHDRAWN", "NOT_GRANTED"]
          }
        }
      }
    },
    "expiration_or_next_review_utc": {"type": "string", "minLength": 1},
    "overall_outcome": {
      "enum": [
        "DRAFT",
        "NO_GO",
        "CONDITIONAL_NO_GO",
        "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED"
      ],
      "description": "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED is a recommendation only. It must never be interpreted as ACQUISITION_AUTHORIZED=true."
    },
    "overall_rationale": {"type": "string", "minLength": 1},
    "acquisition_authorized_by_this_record": {
      "const": false,
      "description": "Immutable false. This record cannot authorize acquisition."
    },
    "gates_unchanged_acknowledgment": {
      "const": true,
      "description": "Preparer acknowledges that completing this record does not change ACQUISITION_AUTHORIZED, INFERENCE_AUTHORIZED, DATA_READINESS, publication, or promotion gates."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_outcome": {
            "const": "GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED"
          }
        },
        "required": ["overall_outcome"]
      },
      "then": {
        "$ref": "#/$defs/go_recommendation_requirements"
      }
    },
    {
      "if": {
        "properties": {"overall_outcome": {"const": "NO_GO"}},
        "required": ["overall_outcome"]
      },
      "then": {
        "properties": {
          "unresolved_blockers": {"type": "array", "minItems": 1}
        },
        "required": ["unresolved_blockers"]
      }
    }
  ],
  "$defs": {
    "recorded_string": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "NOT_RECORDED",
          "NOT_STARTED",
          "PENDING",
          "VACANT",
          "PLACEHOLDER",
          "UNKNOWN",
          "TBD",
          "NOT_APPLICABLE"
        ]
      },
      "description": "Non-placeholder recorded value for GO recommendations. Rejects exact unfinished-state sentinels only; explanatory prose that mentions pending work remains valid when the field value is not itself a sentinel."
    },
    "assigned_actor_ref": {
      "type": "string",
      "minLength": 8,
      "allOf": [
        {
          "not": {
            "enum": [
              "NOT_RECORDED",
              "NOT_STARTED",
              "PENDING",
              "VACANT",
              "PLACEHOLDER",
              "UNKNOWN",
              "TBD",
              "NOT_APPLICABLE"
            ]
          }
        },
        {"not": {"pattern": "VACANT"}},
        {"not": {"pattern": "PLACEHOLDER"}},
        {"not": {"pattern": "PENDING"}},
        {"not": {"pattern": "NOT_STARTED"}},
        {"not": {"pattern": "NOT_RECORDED"}},
        {"not": {"pattern": "UNKNOWN"}},
        {"not": {"pattern": "TBD"}}
      ],
      "description": "Assigned role reference for GO recommendations. Vacant, placeholder, and unfinished-state tokens cannot satisfy required reviewer or owner seats."
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "title", "uri_or_path", "retrieved_at_utc"],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^eref_[A-Za-z0-9_-]{4,64}$"
        },
        "title": {"type": "string", "minLength": 1},
        "uri_or_path": {"type": "string", "minLength": 1},
        "retrieved_at_utc": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^([a-f0-9]{64}|NOT_RECORDED)$"
        },
        "notes": {"type": "string"}
      }
    },
    "completed_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "title",
        "uri_or_path",
        "retrieved_at_utc",
        "sha256"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^eref_[A-Za-z0-9_-]{4,64}$"
        },
        "title": {"$ref": "#/$defs/recorded_string"},
        "uri_or_path": {"$ref": "#/$defs/recorded_string"},
        "retrieved_at_utc": {"$ref": "#/$defs/recorded_string"},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Required 64-hex checksum for GO-path evidence; NOT_RECORDED is rejected."
        },
        "notes": {"type": "string"}
      }
    },
    "applicability_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "status", "reviewer_ref", "evidence_refs"],
      "properties": {
        "applicability": {
          "enum": ["APPLICABLE", "NOT_APPLICABLE", "NOT_RECORDED"]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "COMPLETE_PASS",
            "COMPLETE_FAIL",
            "EXPIRED",
            "WITHDRAWN",
            "NOT_RECORDED"
          ]
        },
        "not_applicable_rationale": {"type": "string"},
        "reviewer_ref": {"type": "string", "minLength": 1},
        "reviewed_at_utc": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"applicability": {"const": "NOT_APPLICABLE"}},
            "required": ["applicability"]
          },
          "then": {
            "required": ["not_applicable_rationale"],
            "properties": {
              "not_applicable_rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "go_applicability_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "reviewer_ref",
        "reviewed_at_utc",
        "evidence_refs"
      ],
      "properties": {
        "applicability": {
          "enum": ["APPLICABLE", "NOT_APPLICABLE"]
        },
        "status": {
          "const": "COMPLETE_PASS"
        },
        "not_applicable_rationale": {"type": "string"},
        "reviewer_ref": {"$ref": "#/$defs/assigned_actor_ref"},
        "reviewed_at_utc": {"$ref": "#/$defs/recorded_string"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completed_evidence_ref"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "applicability": {"const": "APPLICABLE"},
            "status": {"const": "COMPLETE_PASS"}
          },
          "required": ["applicability", "status"]
        },
        {
          "properties": {
            "applicability": {"const": "NOT_APPLICABLE"},
            "status": {"const": "COMPLETE_PASS"},
            "not_applicable_rationale": {
              "type": "string",
              "minLength": 16
            }
          },
          "required": [
            "applicability",
            "status",
            "not_applicable_rationale"
          ]
        }
      ],
      "description": "Structurally complete applicability determination for a GO recommendation. Does not prove legal or ethical truth."
    },
    "go_complete_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "canonical_name",
        "public_urls",
        "intended_acquisition_method",
        "scope_limit",
        "terms_evidence_refs",
        "copyright_redistribution_notes",
        "provider_permission_status",
        "storage_transformation_publication_restrictions",
        "reviewer_ref",
        "reviewed_at_utc",
        "evidence_refs",
        "expiration_or_review_by"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source_[A-Za-z0-9_-]{4,64}$"
        },
        "canonical_name": {"$ref": "#/$defs/recorded_string"},
        "public_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/recorded_string"}
        },
        "intended_acquisition_method": {"$ref": "#/$defs/recorded_string"},
        "scope_limit": {"$ref": "#/$defs/recorded_string"},
        "terms_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completed_evidence_ref"}
        },
        "copyright_redistribution_notes": {"$ref": "#/$defs/recorded_string"},
        "provider_permission_status": {
          "enum": ["REQUIRED_OBTAINED", "NOT_REQUIRED"]
        },
        "provider_permission_rationale": {"type": "string"},
        "storage_transformation_publication_restrictions": {
          "$ref": "#/$defs/recorded_string"
        },
        "reviewer_ref": {"$ref": "#/$defs/assigned_actor_ref"},
        "reviewed_at_utc": {"$ref": "#/$defs/recorded_string"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completed_evidence_ref"}
        },
        "expiration_or_review_by": {"$ref": "#/$defs/recorded_string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider_permission_status": {"const": "NOT_REQUIRED"}
            },
            "required": ["provider_permission_status"]
          },
          "then": {
            "required": ["provider_permission_rationale"],
            "properties": {
              "provider_permission_rationale": {
                "type": "string",
                "minLength": 16
              }
            }
          }
        }
      ]
    },
    "go_required_reviewer": {
      "type": "object",
      "required": [
        "reviewer_ref",
        "role",
        "decision",
        "decided_at_utc",
        "evidence_refs"
      ],
      "properties": {
        "reviewer_ref": {"$ref": "#/$defs/assigned_actor_ref"},
        "decision": {"const": "APPROVE_FOR_RECOMMENDATION_REVIEW"},
        "decided_at_utc": {"$ref": "#/$defs/recorded_string"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completed_evidence_ref"}
        }
      }
    },
    "go_recommendation_requirements": {
      "description": "Structural completeness gate for GO_RECOMMENDED_SEPARATE_AUTHORIZATION_REQUIRED. Empty unresolved_blockers alone is insufficient. Schema validity is not authorization and cannot prove rights or approval authenticity.",
      "type": "object",
      "required": [
        "created_at_utc",
        "research_purpose",
        "proposed_sources",
        "rights_and_license_review",
        "privacy_consent_ethics_review",
        "faculty_or_institutional_review",
        "ground_truth_requirements",
        "dataset_design_and_leakage_plan",
        "security_storage_retention_plan",
        "budget_and_ownership",
        "reviewers",
        "unresolved_blockers",
        "overall_rationale",
        "acquisition_authorized_by_this_record",
        "gates_unchanged_acknowledgment"
      ],
      "properties": {
        "acquisition_authorized_by_this_record": {"const": false},
        "gates_unchanged_acknowledgment": {"const": true},
        "created_at_utc": {"$ref": "#/$defs/recorded_string"},
        "overall_rationale": {
          "type": "string",
          "minLength": 32
        },
        "research_purpose": {
          "type": "object",
          "required": [
            "research_questions",
            "permitted_model_development_purpose",
            "product_category_scope",
            "intended_audience",
            "publication_boundaries",
            "explicit_out_of_scope_uses"
          ],
          "properties": {
            "research_questions": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/recorded_string"}
            },
            "permitted_model_development_purpose": {
              "enum": [
                "ML_EVALUATION_ONLY",
                "NONPUBLIC_RESEARCH",
                "PUBLICATION_OF_AGGREGATES",
                "OTHER_DOCUMENTED"
              ]
            },
            "product_category_scope": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/recorded_string"}
            },
            "intended_audience": {"$ref": "#/$defs/recorded_string"},
            "publication_boundaries": {"$ref": "#/$defs/recorded_string"},
            "explicit_out_of_scope_uses": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/recorded_string"}
            }
          }
        },
        "proposed_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/go_complete_source"}
        },
        "rights_and_license_review": {
          "$ref": "#/$defs/go_applicability_block"
        },
        "privacy_consent_ethics_review": {
          "$ref": "#/$defs/go_applicability_block"
        },
        "faculty_or_institutional_review": {
          "$ref": "#/$defs/go_applicability_block"
        },
        "ground_truth_requirements": {
          "type": "object",
          "required": [
            "independent_verification_procedure_ref",
            "reviewer_qualification_requirements",
            "dual_review_and_adjudication_defined",
            "excludes_filename_directory_scraper_seller_model_synthetic_as_gt",
            "distinction_review_eligibility_vs_ml_admission_documented",
            "evidence_refs"
          ],
          "properties": {
            "independent_verification_procedure_ref": {
              "$ref": "#/$defs/recorded_string"
            },
            "reviewer_qualification_requirements": {
              "$ref": "#/$defs/recorded_string"
            },
            "dual_review_and_adjudication_defined": {"const": true},
            "excludes_filename_directory_scraper_seller_model_synthetic_as_gt": {
              "const": true
            },
            "distinction_review_eligibility_vs_ml_admission_documented": {
              "const": true
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/completed_evidence_ref"}
            }
          }
        },
        "dataset_design_and_leakage_plan": {
          "type": "object",
          "required": [
            "identity_scheme",
            "duplicate_detection_policy",
            "disjointness_rules",
            "split_separation_policy_level_only",
            "final_test_ood_inspection_prohibited",
            "missing_metadata_reporting",
            "proposed_thresholds_require_human_approval",
            "evidence_refs"
          ],
          "properties": {
            "identity_scheme": {"$ref": "#/$defs/recorded_string"},
            "duplicate_detection_policy": {"$ref": "#/$defs/recorded_string"},
            "disjointness_rules": {"$ref": "#/$defs/recorded_string"},
            "split_separation_policy_level_only": {
              "$ref": "#/$defs/recorded_string"
            },
            "final_test_ood_inspection_prohibited": {"const": true},
            "missing_metadata_reporting": {"$ref": "#/$defs/recorded_string"},
            "proposed_thresholds_require_human_approval": {"const": true},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/completed_evidence_ref"}
            }
          }
        },
        "security_storage_retention_plan": {
          "type": "object",
          "required": [
            "storage_designation",
            "access_control_summary",
            "checksum_and_audit_requirements",
            "retention_and_backup_policy",
            "deletion_takedown_quarantine_procedures",
            "incident_owner_ref",
            "evidence_refs"
          ],
          "properties": {
            "storage_designation": {"$ref": "#/$defs/recorded_string"},
            "access_control_summary": {"$ref": "#/$defs/recorded_string"},
            "checksum_and_audit_requirements": {
              "$ref": "#/$defs/recorded_string"
            },
            "retention_and_backup_policy": {"$ref": "#/$defs/recorded_string"},
            "deletion_takedown_quarantine_procedures": {
              "$ref": "#/$defs/recorded_string"
            },
            "incident_owner_ref": {"$ref": "#/$defs/assigned_actor_ref"},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/completed_evidence_ref"}
            }
          }
        },
        "budget_and_ownership": {
          "type": "object",
          "required": [
            "budget_mode",
            "accountable_owner_ref",
            "time_window",
            "volume_or_rate_limits",
            "stop_condition_before_expenditure",
            "evidence_refs"
          ],
          "properties": {
            "budget_mode": {
              "enum": ["ZERO_BUDGET_DESK_ONLY", "CEILING_DOCUMENTED"]
            },
            "budget_ceiling": {"type": "string"},
            "funding_source": {"type": "string"},
            "accountable_owner_ref": {"$ref": "#/$defs/assigned_actor_ref"},
            "time_window": {"$ref": "#/$defs/recorded_string"},
            "volume_or_rate_limits": {"$ref": "#/$defs/recorded_string"},
            "stop_condition_before_expenditure": {
              "$ref": "#/$defs/recorded_string"
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/completed_evidence_ref"}
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "budget_mode": {"const": "CEILING_DOCUMENTED"}
                },
                "required": ["budget_mode"]
              },
              "then": {
                "required": ["budget_ceiling", "funding_source"],
                "properties": {
                  "budget_ceiling": {"$ref": "#/$defs/recorded_string"},
                  "funding_source": {"$ref": "#/$defs/recorded_string"}
                }
              }
            }
          ]
        },
        "reviewers": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_ref",
              "role",
              "decision",
              "decided_at_utc",
              "evidence_refs"
            ],
            "properties": {
              "reviewer_ref": {"$ref": "#/$defs/assigned_actor_ref"},
              "role": {
                "enum": [
                  "PREPARER",
                  "RIGHTS_LICENSE",
                  "PRIVACY_ETHICS",
                  "GROUND_TRUTH",
                  "DATASET_INTEGRITY",
                  "SECURITY_RETENTION",
                  "BUDGET_OWNER",
                  "LEAD_REVIEWER",
                  "OTHER"
                ]
              },
              "decision": {
                "const": "APPROVE_FOR_RECOMMENDATION_REVIEW"
              },
              "not_applicable_rationale": {"type": "string"},
              "decided_at_utc": {"$ref": "#/$defs/recorded_string"},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/completed_evidence_ref"}
              },
              "notes": {"type": "string"}
            }
          },
          "allOf": [
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "PREPARER"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "RIGHTS_LICENSE"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "PRIVACY_ETHICS"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "GROUND_TRUTH"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "DATASET_INTEGRITY"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "SECURITY_RETENTION"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "BUDGET_OWNER"}},
                    "required": ["role"]
                  }
                ]
              }
            },
            {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/go_required_reviewer"},
                  {
                    "properties": {"role": {"const": "LEAD_REVIEWER"}},
                    "required": ["role"]
                  }
                ]
              }
            }
          ]
        },
        "unresolved_blockers": {
          "type": "array",
          "items": {
            "not": {
              "properties": {
                "severity": {"const": "CRITICAL"},
                "status": {"enum": ["OPEN", "IN_PROGRESS"]}
              },
              "required": ["severity", "status"]
            }
          }
        }
      }
    }
  }
}
