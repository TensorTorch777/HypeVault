{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypevault.example/schemas/phase55-evidence-ledger.schema.json",
  "title": "HypeVault Phase 55 Evidence Ledger Record",
  "description": "Preflight schema for pseudonymized evidence metadata. It does not authorize acquisition or model inference. Do not store images, raw serials, customer PII, reviewer names, credentials, or private correspondence in records committed to Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id", "image_sha256", "product_id", "declared_brand", "verified_brand",
    "reference_family", "source_id", "seller_id", "marketplace_id",
    "historical_directory_label", "reviewer_a_outcome", "reviewer_b_outcome",
    "evidence_category_a", "evidence_category_b", "adjudication_status",
    "adjudication_outcome", "verified_label", "license_status", "consent_status",
    "permitted_purposes", "retention_until", "deletion_status",
    "source_product_disjointness", "eligible_primary_benchmark"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^sample_[A-Za-z0-9_-]{8,64}$"},
    "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_id": {"type": "string", "minLength": 1, "description": "Pseudonymous physical-watch identifier or UNKNOWN."},
    "declared_brand": {"type": "string", "minLength": 1, "description": "Brand supplied by uploader or folder; not verified by this field."},
    "verified_brand": {"type": "string", "minLength": 1, "description": "Evidence-supported brand/reference family or UNKNOWN."},
    "reference_family": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1, "description": "Pseudonymous source identity or UNKNOWN."},
    "seller_id": {"type": "string", "minLength": 1, "description": "Pseudonymous seller identity or UNKNOWN."},
    "marketplace_id": {"type": "string", "minLength": 1, "description": "Pseudonymous marketplace identity or UNKNOWN."},
    "historical_directory_label": {"enum": ["Label_0_Watches", "Label_1_Watches", "UNKNOWN"], "description": "Historical folder metadata only; never ground truth."},
    "reviewer_a_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT", "INDETERMINATE", "NOT_REVIEWED"]},
    "reviewer_b_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT", "INDETERMINATE", "NOT_REVIEWED"]},
    "evidence_category_a": {"enum": ["MANUFACTURER_PROVENANCE", "AUTHORIZED_SERVICE_RECORD", "QUALIFIED_PHYSICAL_EXAMINATION", "DOCUMENTED_CHAIN_OF_PROVENANCE", "OTHER_DOCUMENTED", "NOT_RECORDED"]},
    "evidence_category_b": {"enum": ["MANUFACTURER_PROVENANCE", "AUTHORIZED_SERVICE_RECORD", "QUALIFIED_PHYSICAL_EXAMINATION", "DOCUMENTED_CHAIN_OF_PROVENANCE", "OTHER_DOCUMENTED", "NOT_RECORDED"]},
    "adjudication_status": {"enum": ["NOT_STARTED", "PENDING", "AGREED", "ADJUDICATED", "UNRESOLVED"]},
    "adjudication_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT", "INDETERMINATE", "NOT_ADJUDICATED"]},
    "verified_label": {"enum": ["AUTHENTIC", "COUNTERFEIT", "INDETERMINATE"], "description": "Only evidence-backed resolved outcome. Not copied from historical_directory_label."},
    "license_status": {"enum": ["APPROVED", "DENIED", "PENDING", "NOT_RECORDED"]},
    "consent_status": {"enum": ["APPROVED", "DENIED", "NOT_REQUIRED", "PENDING", "NOT_RECORDED"]},
    "permitted_purposes": {"type": "array", "uniqueItems": true, "items": {"enum": ["ML_EVALUATION", "NONPUBLIC_RESEARCH", "PUBLICATION_OF_AGGREGATES", "OTHER"]}},
    "retention_until": {"anyOf": [{"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"const": "UNKNOWN"}]},
    "deletion_status": {"enum": ["NOT_APPLICABLE", "RETENTION_ACTIVE", "PENDING_DELETION", "DELETED", "NOT_RECORDED"]},
    "source_product_disjointness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dinov2_legacy", "dinov3_experimental"],
      "properties": {
        "dinov2_legacy": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "dinov3_experimental": {"enum": ["PASS", "FAIL", "UNKNOWN"]}
      }
    },
    "eligible_primary_benchmark": {"type": "boolean", "default": false}
  },
  "allOf": [
    {
      "if": {"properties": {"eligible_primary_benchmark": {"const": true}}, "required": ["eligible_primary_benchmark"]},
      "then": {
        "required": ["sample_id", "image_sha256", "product_id", "source_id", "verified_label", "reviewer_a_outcome", "reviewer_b_outcome", "evidence_category_a", "evidence_category_b", "adjudication_status", "adjudication_outcome", "license_status", "consent_status", "permitted_purposes", "retention_until", "deletion_status", "source_product_disjointness"],
        "properties": {
          "product_id": {"not": {"const": "UNKNOWN"}},
          "source_id": {"not": {"const": "UNKNOWN"}},
          "verified_brand": {"not": {"const": "UNKNOWN"}},
          "verified_label": {"enum": ["AUTHENTIC", "COUNTERFEIT"]},
          "reviewer_a_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT"]},
          "reviewer_b_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT"]},
          "evidence_category_a": {"not": {"const": "NOT_RECORDED"}},
          "evidence_category_b": {"not": {"const": "NOT_RECORDED"}},
          "adjudication_status": {"enum": ["AGREED", "ADJUDICATED"]},
          "adjudication_outcome": {"enum": ["AUTHENTIC", "COUNTERFEIT"]},
          "license_status": {"const": "APPROVED"},
          "consent_status": {"enum": ["APPROVED", "NOT_REQUIRED"]},
          "permitted_purposes": {"contains": {"const": "ML_EVALUATION"}},
          "retention_until": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "deletion_status": {"const": "RETENTION_ACTIVE"},
          "source_product_disjointness": {
            "properties": {"dinov2_legacy": {"const": "PASS"}, "dinov3_experimental": {"const": "PASS"}}
          }
        },
        "anyOf": [
          {"properties": {"adjudication_status": {"const": "AGREED"}, "adjudication_outcome": {"const": "AUTHENTIC"}, "verified_label": {"const": "AUTHENTIC"}, "reviewer_a_outcome": {"const": "AUTHENTIC"}, "reviewer_b_outcome": {"const": "AUTHENTIC"}}},
          {"properties": {"adjudication_status": {"const": "AGREED"}, "adjudication_outcome": {"const": "COUNTERFEIT"}, "verified_label": {"const": "COUNTERFEIT"}, "reviewer_a_outcome": {"const": "COUNTERFEIT"}, "reviewer_b_outcome": {"const": "COUNTERFEIT"}}},
          {"properties": {"adjudication_status": {"const": "ADJUDICATED"}, "adjudication_outcome": {"const": "AUTHENTIC"}, "verified_label": {"const": "AUTHENTIC"}, "reviewer_a_outcome": {"const": "AUTHENTIC"}, "reviewer_b_outcome": {"const": "COUNTERFEIT"}}},
          {"properties": {"adjudication_status": {"const": "ADJUDICATED"}, "adjudication_outcome": {"const": "AUTHENTIC"}, "verified_label": {"const": "AUTHENTIC"}, "reviewer_a_outcome": {"const": "COUNTERFEIT"}, "reviewer_b_outcome": {"const": "AUTHENTIC"}}},
          {"properties": {"adjudication_status": {"const": "ADJUDICATED"}, "adjudication_outcome": {"const": "COUNTERFEIT"}, "verified_label": {"const": "COUNTERFEIT"}, "reviewer_a_outcome": {"const": "AUTHENTIC"}, "reviewer_b_outcome": {"const": "COUNTERFEIT"}}},
          {"properties": {"adjudication_status": {"const": "ADJUDICATED"}, "adjudication_outcome": {"const": "COUNTERFEIT"}, "verified_label": {"const": "COUNTERFEIT"}, "reviewer_a_outcome": {"const": "COUNTERFEIT"}, "reviewer_b_outcome": {"const": "AUTHENTIC"}}}
        ]
      }
    }
  ]
}
